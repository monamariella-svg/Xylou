# Copie ce fichier en .env.local et renseigne les valeurs depuis ton projet
# Supabase Xylou (Project Settings > API). .env.local n'est jamais committé.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service role — jamais exposée au client. Réservée aux traitements serveur
# qui doivent contourner RLS (génération du bilan trimestriel, purge RGPD).
SUPABASE_SERVICE_ROLE_KEY=

# Génération IA (bilan de positionnement, adaptation des supports, missions).
# Sans clé, les appels IA sont désactivés et l'app reste utilisable en saisie manuelle.
ANTHROPIC_API_KEY=

# Modèles utilisés — approche hybride décrite au §3.7 du dossier projet :
# un modèle économique pour les interactions fréquentes, un modèle capable pour
# le bilan, l'adaptation de supports et le bilan trimestriel.
XYLOU_MODELE_RAPIDE=claude-haiku-4-5-20251001
XYLOU_MODELE_CAPABLE=claude-sonnet-5

# URL publique du site, sans barre oblique finale. Elle préfixe les chemins
# applicatifs des notifications : sans elle, le bouton d'un courriel ne mène
# nulle part, et la route d'envoi refuse de partir plutôt que d'expédier un lot
# de messages morts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Envoi des notifications par courriel (migration 0059, route /api/envois)
#
# La file se remplit toute seule dès qu'une notification naît ; sans ces trois
# valeurs elle se remplit sans jamais se vider, et personne n'apprend rien hors
# de l'application. Les échecs restent visibles dans l'écran d'administration.
# ---------------------------------------------------------------------------

# Clé Resend (resend.com › API Keys).
RESEND_API_KEY=

# Expéditeur, sur un domaine vérifié chez Resend : « Xylou <notifications@…> ».
# Une adresse sur un domaine non vérifié fait échouer chaque envoi.
RESEND_FROM=

# Protège /api/envois : sans secret configuré, la route reste fermée. Sur
# Vercel, définir cette variable suffit — la tâche planifiée de vercel.json
# joint elle-même l'en-tête « Authorization: Bearer <CRON_SECRET> ».
# En local : openssl rand -hex 32
CRON_SECRET=
