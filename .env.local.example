# Copie ce fichier en .env.local et renseigne les valeurs depuis ton projet
# Supabase Xylou (Project Settings > API). .env.local n'est jamais committé.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service role — jamais exposée au client. Réservée aux traitements serveur
# qui doivent contourner RLS (génération du bilan trimestriel, purge RGPD).
SUPABASE_SERVICE_ROLE_KEY=

# Génération IA (bilan de positionnement, adaptation des supports, missions).
# Sans clé, les appels IA sont désactivés et l'app reste utilisable en saisie manuelle.
ANTHROPIC_API_KEY=

# Modèles utilisés — approche hybride décrite au §3.7 du dossier projet :
# un modèle économique pour les interactions fréquentes, un modèle capable pour
# le bilan, l'adaptation de supports et le bilan trimestriel.
XYLOU_MODELE_RAPIDE=claude-haiku-4-5-20251001
XYLOU_MODELE_CAPABLE=claude-sonnet-5

# URL publique du site (liens dans les emails d'invitation d'un enseignant)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
